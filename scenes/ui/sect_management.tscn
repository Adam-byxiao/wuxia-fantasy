[gd_scene format=3]

[node name="SectManagement" type="PanelContainer"]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 400.0
grow_horizontal = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 15

[node name="TitleBar" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/VBox/TitleBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "宗门管理"

[node name="BackBtn" type="Button" parent="Margin/VBox/TitleBar"]
layout_mode = 2
text = "返回"

[node name="Content" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 20

[node name="MemberPanel" type="VBoxContainer" parent="Margin/VBox/Content"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
size_flags_horizontal = 2
theme_override_constants/separation = 10

[node name="MemberTitle" type="Label" parent="Margin/VBox/Content/MemberPanel"]
layout_mode = 2
text = "成员列表"

[node name="MemberList" type="ScrollContainer" parent="Margin/VBox/Content/MemberPanel"]
custom_minimum_size = Vector2(0, 280)
layout_mode = 2
size_flags_vertical = 3

[node name="MemberListVBox" type="VBoxContainer" parent="Margin/VBox/Content/MemberPanel/MemberList"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 5

[node name="DetailPanel" type="VBoxContainer" parent="Margin/VBox/Content"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="DetailTitle" type="Label" parent="Margin/VBox/Content/DetailPanel"]
layout_mode = 2
text = "成员详情"

[node name="DetailText" type="RichTextLabel" parent="Margin/VBox/Content/DetailPanel"]
custom_minimum_size = Vector2(0, 200)
layout_mode = 2
size_flags_vertical = 3
text = "选择一个成员查看详情"

[node name="PositionBtn" type="Button" parent="Margin/VBox/Content/DetailPanel"]
layout_mode = 2
text = "调整职位"

[node name="KickBtn" type="Button" parent="Margin/VBox/Content/DetailPanel"]
layout_mode = 2
text = "开除成员"
