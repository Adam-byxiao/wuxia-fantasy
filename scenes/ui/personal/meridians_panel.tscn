[gd_scene format=3]

[node name="MeridiansPanel" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 15

[node name="Title" type="Label" parent="."]
layout_mode = 2
text = "经脉系统"

[node name="MeridianGrid" type="GridContainer" parent="."]
custom_minimum_size = Vector2(0, 200)
layout_mode = 2
columns = 6
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Separator" type="HSeparator" parent="."]
layout_mode = 2

[node name="CultivationInfo" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 30

[node name="LeftInfo" type="VBoxContainer" parent="CultivationInfo"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="RealmLabel" type="Label" parent="CultivationInfo/LeftInfo"]
layout_mode = 2
text = "当前境界: 后天"

[node name="ProgressLabel" type="Label" parent="CultivationInfo/LeftInfo"]
layout_mode = 2
text = "修为进度: 0%"

[node name="ProgressBar" type="ProgressBar" parent="CultivationInfo/LeftInfo"]
layout_mode = 2

[node name="RightInfo" type="VBoxContainer" parent="CultivationInfo"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="CultivateBtn" type="Button" parent="CultivationInfo/RightInfo"]
layout_mode = 2
text = "闭关修炼"

[node name="BreakthroughBtn" type="Button" parent="CultivationInfo/RightInfo"]
layout_mode = 2
text = "突破"
