[gd_scene format=3]

[node name="RelationsPanel" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="."]
layout_mode = 2
text = "关系列表"

[node name="Scroll" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 350)
layout_mode = 2
size_flags_vertical = 3

[node name="RelationList" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 5

[node name="EmptyHint" type="Label" parent="Scroll/RelationList"]
layout_mode = 2
text = "暂无关系记录"
