[gd_scene format=3]

[node name="BattleUIPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="TopBar" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -100.0
grow_horizontal = 2
grow_vertical = 0

[node name="TurnLabel" type="Label" parent="TopBar"]
layout_mode = 2
text = "玩家回合"

[node name="Spacer" type="Control" parent="TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="EnemyCountLabel" type="Label" parent="TopBar"]
layout_mode = 2
text = "敌人: 0"

[node name="EnemyList" type="VBoxContainer" parent="."]
custom_minimum_size = Vector2(180, 0)
layout_mode = 1
anchors_preset = 4
anchor_left = 1.0
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -200.0
offset_bottom = 200.0
grow_horizontal = 0
grow_vertical = 2

[node name="BottomPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -500.0
offset_top = -250.0
grow_horizontal = 0
grow_vertical = 0

[node name="Margin" type="MarginContainer" parent="BottomPanel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="SkillGrid" type="GridContainer" parent="BottomPanel/Margin"]
layout_mode = 2
columns = 4
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Skill1" type="Button" parent="BottomPanel/Margin/SkillGrid"]
layout_mode = 2
text = "技能1"

[node name="Skill2" type="Button" parent="BottomPanel/Margin/SkillGrid"]
layout_mode = 2
text = "技能2"

[node name="Skill3" type="Button" parent="BottomPanel/Margin/SkillGrid"]
layout_mode = 2
text = "技能3"

[node name="Skill4" type="Button" parent="BottomPanel/Margin/SkillGrid"]
layout_mode = 2
text = "技能4"

[node name="NormalAttack" type="Button" parent="BottomPanel/Margin/SkillGrid"]
layout_mode = 2
text = "普通攻击"

[node name="Defend" type="Button" parent="BottomPanel/Margin/SkillGrid"]
layout_mode = 2
text = "防御"

[node name="Items" type="Button" parent="BottomPanel/Margin/SkillGrid"]
layout_mode = 2
text = "物品"

[node name="Escape" type="Button" parent="BottomPanel/Margin/SkillGrid"]
layout_mode = 2
text = "逃跑"

[node name="PlayerInfo" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = -120.0
offset_right = 250.0
offset_bottom = -20.0
grow_vertical = 0

[node name="VBox" type="VBoxContainer" parent="PlayerInfo"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Name" type="Label" parent="PlayerInfo/VBox"]
layout_mode = 2
text = "玩家"

[node name="HP" type="Label" parent="PlayerInfo/VBox"]
layout_mode = 2
text = "HP: 100/100"

[node name="HPBar" type="ProgressBar" parent="PlayerInfo/VBox"]
layout_mode = 2

[node name="Qi" type="Label" parent="PlayerInfo/VBox"]
layout_mode = 2
text = "气: 50/50"

[node name="QiBar" type="ProgressBar" parent="PlayerInfo/VBox"]
layout_mode = 2

[node name="Realm" type="Label" parent="PlayerInfo/VBox"]
layout_mode = 2
text = "境界: 后天"

[node name="BattleLog" type="RichTextLabel" parent="."]
custom_minimum_size = Vector2(400, 200)
layout_mode = 1
anchors_preset = 0
offset_left = 20.0
offset_top = 20.0
offset_right = 420.0
offset_bottom = 220.0
size_flags_horizontal = 0
size_flags_vertical = 0
text = "战斗日志..."
