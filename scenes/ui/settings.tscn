[gd_scene format=3]

[node name="SettingsPanel" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -150.0
offset_right = 200.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 15

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
horizontal_alignment = 1
text = "设置"

[node name="VolumeRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="VolumeLabel" type="Label" parent="VBox/VolumeRow"]
layout_mode = 2
text = "音量"

[node name="VolumeSlider" type="HSlider" parent="VBox/VolumeRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 1.0
step = 0.1
value = 0.8

[node name="SpeedRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SpeedLabel" type="Label" parent="VBox/SpeedRow"]
layout_mode = 2
text = "文字速度"

[node name="SpeedSlider" type="HSlider" parent="VBox/SpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.5
max_value = 3.0
step = 0.5
